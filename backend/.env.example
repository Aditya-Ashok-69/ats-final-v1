DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-secret-change-me-in-production"
PORT=4000

# URL of the Python resume-parser microservice (optional, defaults to localhost:8000)
# If unset or the service is unreachable, scoring falls back to text-only mode.
RESUME_PARSER_URL="http://localhost:8000"

# Anthropic API key — used to parse uploaded JD documents into structured fields
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-your-key-here"
